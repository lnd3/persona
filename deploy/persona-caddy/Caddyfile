# persona's landing page's TLS-terminating sidecar — same shape as
# cinder's own deploy/cinderapps/Caddyfile and EphemNet's own
# deploy/ephemnet-caddy/Caddyfile (D007's pattern), reused directly
# rather than reinvented: same global options (scoped listener wrapper
# for PROXY protocol from nginx's stream{} passthrough), same
# HTTP-01-not-TLS-ALPN-01 ACME shape after cinder's own real,
# extensively-diagnosed production failure with TLS-ALPN-01 (see
# cinder's D007 Log).
#
# Since A010 (2026-10-01): reverse-proxies to persona-web
# (cmd/persona-web), a real Go binary, instead of serving
# site/index.html directly — persona-web is what reports page views to
# wisp, which needs to run inside the code actually handling the
# request, not this TLS sidecar. `header_up X-Real-IP` passes the real
# client IP through; persona-web trusts it only when the request's own
# RemoteAddr is inside persona-edge (see cmd/persona-web/main.go's own
# trustedProxyClientIP) — the only other thing on that network is this
# container, so nothing else can forge it.
#
# {$PERSONA_DOMAIN} is Caddy's own native env-var substitution — set
# via deploy/.env's PERSONA_DOMAIN (docker-compose.yml passes it
# through as a container env var).
{
	auto_https disable_redirects

	# Scoped to :443 only — an unscoped block would also wrap the
	# auto-created :80 HTTP-01 listener in TLS, breaking it (same
	# reasoning as cinder's/EphemNet's own Caddyfiles).
	servers :443 {
		listener_wrappers {
			# `allow` must match persona-edge's own subnet in
			# deploy/docker-compose.yml — the only network this
			# container is on, so the only one nginx can reach it from.
			proxy_protocol {
				timeout 2s
				allow {$PERSONA_EDGE_SUBNET}
			}
			tls
		}
	}
}

{$PERSONA_DOMAIN} {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	reverse_proxy persona-web:8080 {
		header_up X-Real-IP {http.request.remote.host}
	}
}

# Explicit http://-\>https:// redirect for real visitor traffic — found
# missing live 2026-09-30 (cinder's and EphemNet's own Caddyfiles have
# the same gap: `auto_https disable_redirects` above turns off Caddy's
# *automatic* redirect listener, since it was "meaningless" for
# cinder's own original problem — real traffic there always arrives via
# nginx's :443 SNI passthrough, never bare :80 — but that's not a safe
# assumption for a landing page real people might type as
# "solemn.network" without a scheme, or paste as a bare http:// link.
# Safe to add explicitly: cinder's own D007 Log confirms Caddy's
# internal ACME HTTP-01 challenge responder on :80 stays active
# independent of any site-block routes defined here, so this redirect
# can't interfere with certificate renewal.
http://{$PERSONA_DOMAIN} {
	redir https://{host}{uri} permanent
}
